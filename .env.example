# Copy values into an untracked local .env file only when the relevant
# infrastructure is deliberately deployed. Do not commit real credentials.

# Create before Step 7 only if Terraform manages DigitalOcean.
DO_TOKEN=

# Create when shared PostgreSQL is deployed.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=

# Create only if DNS is managed through Terraform or automation.
CLOUDFLARE_API_TOKEN=
