# Copy names to ~/.config/wood/infrastructure/dev.env; do not commit the file.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
WES_DATABASE_URL=
# Architecture Docs resolves its URL directly from Infisical in the postgres role.
DAGSTER_POSTGRES_PASSWORD=
MACBOOK_DAGSTER_HOST=
OPENWEBUI_DATABASE_PASSWORD=
OPENWEBUI_OPENAI_API_BASE_URL=
OPENWEBUI_OPENAI_API_KEY=
OPENWEBUI_OLLAMA_BASE_URL=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
INFISICAL_POSTGRES_PASSWORD=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_SITE_URL=
WEBSITE_PORTFOLIO_DATABASE_URL=
WEBSITE_PORTFOLIO_MIGRATION_DATABASE_URL=
WEBSITE_PORTFOLIO_GHCR_TOKEN=
# Optional public runtime configuration. Keep blank when RudderStack is unused.
WEBSITE_PORTFOLIO_RUDDERSTACK_WRITE_KEY=
WEBSITE_PORTFOLIO_RUDDERSTACK_DATA_PLANE_URL=
