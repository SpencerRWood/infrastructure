[Unit]
Description=Resolve Infisical environment and reconcile %i
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/deploy-infrastructure-infisical-service %i
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
