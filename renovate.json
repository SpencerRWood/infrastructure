{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "custom.regex"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "pinDigests": true,
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "vulnerabilityAlerts": {
    "automerge": true,
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps"
  },
  "packageRules": [
    {
      "description": "Default Docker updates to manual review; later rules opt into safe maintenance only.",
      "matchDatasources": ["docker"],
      "automerge": false
    },
    {
      "description": "Automatically merge Docker digest pinning updates.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Automatically merge Docker patch updates.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "groupName": "{{depName}} patch update"
    },
    {
      "description": "Docker minor updates require explicit review, overriding broad Docker defaults.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Docker major updates require explicit review, overriding broad Docker defaults.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep Overleaf MongoDB on the verified 8.0 release line; other lines need application, kernel and data-upgrade validation.",
      "matchFileNames": ["compose/overleaf/compose.yml"],
      "matchPackageNames": ["mongo"],
      "allowedVersions": ">=8.0.0 <8.1.0"
    },
    {
      "description": "Keep Overleaf Redis on the verified 7.4 release line until a separate compatibility review.",
      "matchFileNames": ["compose/overleaf/compose.yml"],
      "matchPackageNames": ["redis"],
      "allowedVersions": ">=7.4.0 <7.5.0"
    },
    {
      "description": "PostgreSQL compatibility-major transitions require explicit review, including digest pinning.",
      "matchPackageNames": ["pgvector/pgvector"],
      "matchNewValue": "/-pg(?:1[7-9]|[2-9][0-9]+)-/",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ansible/roles/keycloak/defaults/main\\.yml$"],
      "matchStrings": ["keycloak_image_tag: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "quay.io/keycloak/keycloak",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/roles/infisical/defaults/main\\.yml$"],
      "matchStrings": ["infisical_image_tag: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "infisical/infisical",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/roles/openwebui/defaults/main\\.yml$"],
      "matchStrings": ["openwebui_image_tag: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "ghcr.io/open-webui/open-webui",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/roles/dagster/defaults/main\\.yml$"],
      "matchStrings": ["dagster_version: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "dagster/dagster",
      "datasourceTemplate": "docker"
    }
  ]
}
