{
  "schema_version": "1",
  "target": {
    "id": "infrastructure-dev",
    "owning_repository": "SpencerRWood/infrastructure",
    "platform": "linux",
    "ephemeral_rebuild": {
      "supported": false,
      "provider": null,
      "environment": null,
      "reason": "isolated_bootstrap_not_supported"
    },
    "adapter": "consumer-command-v1",
    "entrypoints": {
      "bootstrap": {
        "entrypoint": "scripts/recovery.py",
        "args": [
          "bootstrap"
        ],
        "timeout_seconds": 10
      },
      "recovery": {
        "entrypoint": "scripts/rollback.py",
        "args": [
          "--environment",
          "infrastructure-dev",
          "--json"
        ],
        "timeout_seconds": 1800
      }
    },
    "validation_commands": [
      {
        "id": "consumer_weekly",
        "levels": ["verification"],
        "command": {
          "entrypoint": "scripts/weekly_recovery.py",
          "args": ["--real-backups"],
          "timeout_seconds": 300
        }
      },
      {
        "id": "consumer_preflight",
        "levels": [
          "readiness"
        ],
        "command": {
          "entrypoint": "scripts/recovery.py",
          "args": [
            "preflight",
            "--local-only"
          ],
          "timeout_seconds": 150
        }
      }
    ],
    "required_dependencies": [
      {
        "id": "infrastructure",
        "kind": "repository",
        "reference": "git://SpencerRWood/infrastructure"
      },
      {
        "id": "application_images",
        "kind": "artifact",
        "reference": "repo://environments/dev.yml"
      },
      {
        "id": "backups_mount",
        "kind": "storage",
        "reference": "mount:///mnt/wood-server-nas/backup_server"
      },
      {
        "id": "runtime_secret_names",
        "kind": "secret",
        "reference": "infisical://Infrastructure%20Dev/dev#environments/dev.yml:infrastructure_infisical_runtime_services"
      },
      {
        "id": "ci_ghcr",
        "kind": "secret",
        "reference": "infisical://33c5aed5-165f-4ef3-845a-2f9d0f9c06d5/ci/github/WEBSITE_PORTFOLIO_GHCR_TOKEN"
      },
      {
        "id": "expected_services",
        "kind": "runbook",
        "reference": "repo://environments/dev.yml#services"
      },
      {
        "id": "expected_endpoints",
        "kind": "runbook",
        "reference": "repo://compose/caddy/routes"
      },
      {
        "id": "database_recovery",
        "kind": "runbook",
        "reference": "repo://docs/recovery-backups.md"
      },
      {
        "id": "ansible",
        "kind": "tool",
        "reference": "ansible-playbook"
      },
      {
        "id": "rollback",
        "kind": "runbook",
        "reference": "repo://docs/rollback-contract.md"
      }
    ],
    "backup_sources": [
      {
        "id": "current_recovery_group",
        "reference": "path:///mnt/wood-server-nas/backup_server/swood-server/infrastructure-dev/current.json",
        "max_age_seconds": 86400
      }
    ],
    "allowed_verification_levels": [
      "readiness", "verification"
    ],
    "cadence_overrides": []
  },
  "preflight": {
    "inventory": "ansible/inventory/dev",
    "inventory_file": "ansible/inventory/dev/hosts.yml",
    "playbook": "ansible/playbooks/dev.yml",
    "ansible_config": "ansible/ansible.cfg",
    "runbooks": [
      "docs/architecture.md",
      "docs/environments.md",
      "docs/secrets.md",
      "docs/infisical-bootstrap.md",
      "docs/postgres-migration-inventory.md",
      "docs/recovery-backups.md",
      "docs/rollback-contract.md"
    ]
  }
}
