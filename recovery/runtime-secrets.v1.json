{
  "schema_version": "1",
  "services": {
    "automerge-repair": {
      "environment": "dev",
      "path": "/automerge-repair",
      "required_keys": [
        "DAGSTER_POSTGRES_PASSWORD"
      ]
    },
    "clsi": {
      "environment": "dev",
      "path": "/clsi",
      "required_keys": [
        "CLSI_USERNAME",
        "CLSI_PASSWORD_HASH",
        "CLSI_PASSWORD"
      ]
    },
    "dagster": {
      "environment": "dev",
      "path": "/dagster",
      "required_keys": [
        "DAGSTER_POSTGRES_PASSWORD",
        "OPENPROJECT_BASE_URL",
        "OPENPROJECT_API_TOKEN",
        "GOOGLE_DRIVE_CREDENTIALS_JSON",
        "GOOGLE_DRIVE_FOLDER_ID"
      ]
    },
    "events-service": {
      "environment": "dev",
      "path": "/events-service",
      "required_keys": [
        "WES_DATABASE_URL",
        "WES_PRODUCER_CREDENTIALS",
        "WES_SUBSCRIPTIONS",
        "WES_NOTIFICATION_POLICIES",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "TELEGRAM_WEBHOOK_SECRET"
      ]
    },
    "keycloak": {
      "environment": "dev",
      "path": "/keycloak",
      "required_keys": [
        "KC_DB_PASSWORD",
        "KC_DB_URL",
        "KEYCLOAK_ADMIN_PASSWORD"
      ]
    },
    "openwebui": {
      "environment": "dev",
      "path": "/openwebui",
      "required_keys": [
        "DATABASE_URL",
        "WEBUI_SECRET_KEY"
      ]
    },
    "overleaf": {
      "environment": "dev",
      "path": "/overleaf",
      "required_keys": [
        "OVERLEAF_INVITE_TOKEN_SECRET"
      ]
    },
    "portfolio-website": {
      "environment": "dev",
      "path": "/portfolio-website",
      "required_keys": [
        "DATABASE_URL"
      ]
    },
    "rag-service": {
      "environment": "dev",
      "path": "/rag-service",
      "required_keys": [
        "RAG_DATABASE_URL"
      ]
    },
    "rag-service-migrations": {
      "environment": "dev",
      "path": "/rag-service-migrations",
      "required_keys": [
        "RAG_DATABASE_URL"
      ]
    },
    "recovery-verification": {
      "environment": "dev",
      "path": "/recovery-verification",
      "required_keys": [
        "DAGSTER_POSTGRES_PASSWORD",
        "RECOVERY_EVENTS_URL",
        "RECOVERY_EVENTS_TOKEN",
        "RECOVERY_INFISICAL_URL",
        "RECOVERY_INFISICAL_PROJECTS",
        "RECOVERY_INFISICAL_TOKEN",
        "RECOVERY_GHCR_USERNAME",
        "RECOVERY_GHCR_TOKEN"
      ]
    }
  }
}
