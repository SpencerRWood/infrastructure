#!/usr/bin/env bash
# Root-owned entrypoint intentionally limited to this runner's canonical
# repository deployment and health paths.  Workflows do not receive a general
# sudo grant.
set -euo pipefail

workspace="${1:?workspace is required}"
operation="${2:?operation is required}"
test "$#" -eq 2
case "$workspace" in
  "{{ github_runner_root }}/_work/"*) ;;
  *) echo 'workspace is outside this runner work directory' >&2; exit 64 ;;
esac
test -d "$workspace/.git"
cd "$workspace"

export ANSIBLE_CONNECTION=local
set -a
# The file is protected, runner-local, and never printed by this wrapper.
test -r "{{ github_runner_secret_file }}"
source "{{ github_runner_secret_file }}"
set +a
case "$operation" in
  apply)
    exec /usr/bin/ansible-playbook -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" {{ github_runner_ansible_extra_args }}
    ;;
  check)
    exec /usr/bin/ansible-playbook -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" --check --diff {{ github_runner_ansible_extra_args }}
    ;;
  health)
    exec {{ github_runner_health_command }}
    ;;
  *) echo 'operation must be apply, check, or health' >&2; exit 64 ;;
esac
