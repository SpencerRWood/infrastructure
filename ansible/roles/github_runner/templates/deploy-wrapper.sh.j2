#!/usr/bin/env bash
# Root-owned entrypoint intentionally limited to this runner's canonical
# repository deployment and health paths.  Workflows do not receive a general
# sudo grant.
set -euo pipefail

workspace="${1:?workspace is required}"
operation="${2:?operation is required}"
test "$#" -eq 2
case "$workspace" in
  "{{ github_runner_root }}/_work/"*) ;;
  *) echo 'workspace is outside this runner work directory' >&2; exit 64 ;;
esac
test -d "$workspace/.git"
cd "$workspace"

export ANSIBLE_CONNECTION=local
export ANSIBLE_CONFIG="$workspace/{{ github_runner_ansible_config_path }}"
set -a
# The file is protected, runner-local, and never printed by this wrapper.
test -r "{{ github_runner_secret_file }}"
source "{{ github_runner_secret_file }}"
set +a
# Resolve this deployment credential only for operations that consume it.
# Clear the legacy value first so Infisical failure cannot fall back to it.
unset WEBSITE_PORTFOLIO_GHCR_TOKEN
if [[ "$operation" == apply || "$operation" == check ]]; then
  WEBSITE_PORTFOLIO_GHCR_TOKEN=$(/usr/local/sbin/resolve-ci-ghcr)
  test -n "$WEBSITE_PORTFOLIO_GHCR_TOKEN"
  export WEBSITE_PORTFOLIO_GHCR_TOKEN
fi
case "$operation" in
  apply-wood-design-system)
    # Releases before WDS onboarding represent the approved no-service baseline.
    # Use the installed current rollback control, never an absent old role/script.
    if [[ ! -f ansible/roles/wood_design_system/tasks/main.yml ]]; then
      exec env WDS_ROLLBACK_APPROVED=true /usr/local/sbin/github-runner-infrastructure-wds-rollback
    fi
    exec /usr/bin/ansible-playbook --connection=local -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" --tags wood_design_system {{ github_runner_ansible_extra_args }}
    ;;
  check-wood-design-system)
    exec /usr/bin/ansible-playbook --connection=local -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" --tags wood_design_system --check --diff {{ github_runner_ansible_extra_args }}
    ;;
  health-wood-design-system)
    if [[ ! -f ansible/roles/wood_design_system/tasks/main.yml ]]; then
      test -z "$(docker ps -q --filter label=com.docker.compose.project=infrastructure-dev-wood-design-system)"
      test ! -e /srv/infrastructure/compose/caddy/routes/wood-design-system.caddy
      test ! -e /srv/docker/proxy/config/sites/wood-design-system.caddy
      echo 'WDS no-service rollback baseline verified.'
      exit 0
    fi
    exec bash scripts/health-check-wood-design-system.sh
    ;;
  apply)
    exec /usr/bin/ansible-playbook --connection=local -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" {{ github_runner_ansible_extra_args }}
    ;;
  check)
    exec /usr/bin/ansible-playbook --connection=local -i "{{ github_runner_inventory_path }}" "{{ github_runner_playbook_path }}" --check --diff {{ github_runner_ansible_extra_args }}
    ;;
  validate)
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0=safe.directory
    export GIT_CONFIG_VALUE_0="$workspace"
    exec bash scripts/validate.sh
    ;;
  health)
    exec {{ github_runner_health_command }}
    ;;
  *) echo 'unsupported infrastructure deployment operation' >&2; exit 64 ;;
esac
