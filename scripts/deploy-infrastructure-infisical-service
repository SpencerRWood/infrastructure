#!/usr/bin/env python3
"""Resolve and reconcile one declared Infrastructure Dev service group."""
import json
import os
import pathlib
import re
import subprocess
import sys

from dagster_external_locations import CURRENT, locations_from_json, publish_locations

CONFIG = pathlib.Path('/etc/infrastructure/infisical-runtime-services.json')


def run():
    if os.geteuid() != 0 or len(sys.argv) not in (2, 3) or (
        len(sys.argv) == 3 and sys.argv[2] != '--recreate'
    ):
        raise ValueError('invalid invocation')
    name = sys.argv[1]
    if not re.fullmatch(r'[a-z][a-z0-9-]*', name):
        raise ValueError('invalid service')
    item = json.loads(CONFIG.read_text())[name]
    has_external_metadata = name == 'dagster' and 'external_code_locations' in item
    desired_locations = item['external_code_locations'] if has_external_metadata else []
    if has_external_metadata:
        locations_from_json(desired_locations)
    for runtime in [item, *item.get('runtime_environments', {}).values()]:
        args = ['/usr/local/sbin/resolve-infrastructure-infisical-env',
                '--environment', runtime['environment'], '--path', runtime['path'],
                '--output', runtime['output']]
        for key in runtime['required_keys']:
            args.extend(['--require', key])
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    base = ['docker', 'compose', '--env-file', item['compose_env_file'],
            '-f', item['compose_file']]
    subprocess.run(base + ['config', '--quiet'], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True)
    up = base + ['up', '-d', '--no-deps']
    if len(sys.argv) == 3:
        up.append('--force-recreate')
    subprocess.run(up + item['compose_services'], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True)
    if has_external_metadata:
        subprocess.run(
            ['/usr/local/sbin/retire-dagster-external-locations',
             '--desired-json', json.dumps(desired_locations),
             '--desired-compose-services-json', json.dumps(item['compose_services'])],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
        )
        publish_locations(CURRENT, desired_locations)
    print(name + ' reconciled')


if __name__ == '__main__':
    try:
        run()
    except Exception:
        print('Infisical service reconciliation failed', file=sys.stderr)
        sys.exit(1)
