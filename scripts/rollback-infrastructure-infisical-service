#!/usr/bin/env python3
"""Restore one service's retained pre-Infisical Compose definition."""
import json
import os
import pathlib
import subprocess
import sys
import tempfile


def run():
    if os.geteuid() != 0 or len(sys.argv) != 2:
        raise ValueError('invalid invocation')
    name = sys.argv[1]
    data = json.loads(pathlib.Path(
        '/etc/infrastructure/infisical-runtime-services.json').read_text())
    if name not in data:
        raise ValueError('invalid rollback target')
    item = data[name]
    active = pathlib.Path(item['compose_file'])
    snapshot = active.with_name('compose.pre-infisical.yml')
    legacy = pathlib.Path(item['legacy_env_file'])
    compose_env = pathlib.Path(item['compose_env_file'])
    if not snapshot.is_file() or not legacy.is_file() or not compose_env.is_file():
        raise ValueError('rollback source unavailable')
    base = ['docker', 'compose', '--env-file', str(compose_env), '-f', str(snapshot)]
    subprocess.run(base + ['config', '--quiet'], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True)
    subprocess.run(['systemctl', 'disable', '--now',
                    'infrastructure-infisical@' + name + '.service'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   check=True)
    fd, tmp = tempfile.mkstemp(prefix='.compose-rollback-', dir=active.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(snapshot.read_bytes())
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, active)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    base = ['docker', 'compose', '--env-file', str(compose_env), '-f', str(active)]
    subprocess.run(base + ['up', '-d', '--no-deps', '--force-recreate'] +
                   item['compose_services'], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True)
    print(name + ' restored from retained legacy source')


if __name__ == '__main__':
    try:
        run()
    except Exception:
        print('Service rollback failed', file=sys.stderr)
        sys.exit(1)
