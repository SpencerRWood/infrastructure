#!/usr/bin/env python3
"""Retire Dagster services previously recorded as external locations."""
import argparse
import json
import pathlib
import subprocess
import sys

from dagster_external_locations import CURRENT, locations_from_json, obsolete_services, read_locations

PROJECT = 'infrastructure-dev-dagster'


def obsolete_containers(previous, desired, desired_compose_services=()):
    obsolete = obsolete_services(previous, desired, desired_compose_services)
    if not obsolete:
        return []
    ids = subprocess.run(
        ['docker', 'ps', '-aq', '--filter', f'label=com.docker.compose.project={PROJECT}'],
        capture_output=True, text=True, check=True,
    ).stdout.splitlines()
    if not ids:
        return []
    containers = json.loads(subprocess.run(
        ['docker', 'inspect', *ids], capture_output=True, text=True, check=True,
    ).stdout)
    return [container['Id'] for container in containers
            if (container.get('Config', {}).get('Labels') or {}).get('com.docker.compose.project') == PROJECT
            and (container.get('Config', {}).get('Labels') or {}).get('com.docker.compose.service')
            in obsolete]


def retire(previous, desired, desired_compose_services=()):
    ids = obsolete_containers(previous, desired, desired_compose_services)
    if ids:
        subprocess.run(['docker', 'rm', '-f', *ids], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return len(ids)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--current-file', type=pathlib.Path, default=CURRENT)
    parser.add_argument('--desired-compose-services-json', required=True)
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument('--desired-json')
    target.add_argument('--desired-file', type=pathlib.Path)
    args = parser.parse_args()
    try:
        previous = read_locations(args.current_file, missing_ok=True)
        desired = (read_locations(args.desired_file) if args.desired_file else
                   locations_from_json(json.loads(args.desired_json)))
        compose_services = json.loads(args.desired_compose_services_json)
        if (not isinstance(compose_services, list) or
                any(not isinstance(service, str) for service in compose_services)):
            raise ValueError('desired Compose services must be a list of names')
        if not set(desired) <= set(compose_services):
            raise ValueError('desired external services absent from Compose services')
        print(f'{retire(previous, desired, compose_services)} obsolete external Dagster containers retired')
    except Exception as exc:
        print(f'External Dagster retirement failed: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
