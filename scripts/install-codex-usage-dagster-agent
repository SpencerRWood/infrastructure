#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
system_label=com.wood.infrastructure-codex-usage-dagster
if launchctl print "system/$system_label" >/dev/null 2>&1; then
  echo "Boot-time Dagster service is installed; login agent is unnecessary."
  exit 0
fi

label=com.wood.infrastructure-codex-usage-dagster-agent
agent_dir="$HOME/Library/LaunchAgents"
log_dir="$HOME/Library/Logs"
agent_path="$agent_dir/$label.plist"
test -x "$repo_dir/.venv-codex-usage/bin/dagster"
test -f "$HOME/.dagster/dagster.yaml"
test -f "$HOME/.config/wood/infrastructure/dev.env"
mkdir -p "$agent_dir" "$log_dir"
cat > "$agent_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>$repo_dir/.venv-codex-usage/bin/python</string>
    <string>$repo_dir/scripts/run-codex-usage-dagster.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$log_dir/infrastructure-codex-usage-dagster.log</string>
  <key>StandardErrorPath</key><string>$log_dir/infrastructure-codex-usage-dagster-error.log</string>
</dict></plist>
EOF
plutil -lint "$agent_path"
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$agent_path"
launchctl print "gui/$(id -u)/$label" | sed -n '1,14p'
