#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
label=com.wood.infrastructure-codex-usage-dagster
plist="/Library/LaunchDaemons/$label.plist"
runtime_user=$(id -un)
runtime_home=$HOME
log_dir="$runtime_home/Library/Logs"

test -x "$repo_dir/.venv-codex-usage/bin/dagster"
test -f "$runtime_home/.dagster/dagster.yaml"
test -f "$runtime_home/.config/wood/infrastructure/dev.env"
mkdir -p "$log_dir"
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT
cat > "$temporary" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-s</string>
    <string>$repo_dir/.venv-codex-usage/bin/python</string>
    <string>$repo_dir/scripts/run-codex-usage-dagster.py</string>
  </array>
  <key>UserName</key><string>$runtime_user</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$log_dir/infrastructure-codex-usage-dagster.log</string>
  <key>StandardErrorPath</key><string>$log_dir/infrastructure-codex-usage-dagster-error.log</string>
</dict></plist>
EOF
plutil -lint "$temporary"
osascript - "$temporary" "$plist" "$label" <<'APPLESCRIPT'
on run arguments
  set sourcePath to quoted form of item 1 of arguments
  set destinationPath to quoted form of item 2 of arguments
  set serviceLabel to quoted form of ("system/" & item 3 of arguments)
  set commandText to "/usr/bin/install -m 0644 " & sourcePath & " " & destinationPath & " && (/bin/launchctl bootout " & serviceLabel & " >/dev/null 2>&1 || true) && /bin/launchctl bootstrap system " & destinationPath
  do shell script commandText with administrator privileges
end run
APPLESCRIPT
launchctl print "system/$label" | sed -n '1,14p'
